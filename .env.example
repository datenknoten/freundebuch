# Database (PostgreSQL 18+)
DATABASE_URL=postgresql://freundebuch:dev_password@localhost:5432/freundebuch_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Server
# Two separate switches, both intentional:
#   ENV      - read by the backend's config: log format, Sentry environment,
#              and whether dev-only guards are open. Defaults to development.
#   NODE_ENV - Node's own switch; package managers prune devDependencies on it
#              and libraries branch on it. Not a substitute for ENV.
ENV=development
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Authentication (Better Auth)
# The value below is a placeholder and is rejected at boot on purpose.
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=your-better-auth-secret-change-this-in-production
# Public origin of the deployment, used as the OAuth issuer / MCP resource base
# for the claude.ai connector. Set to your public HTTPS URL in production
# (e.g. https://freundebuch.example.com). When unset it falls back to
# FRONTEND_URL. Must be identical for the backend and mcp-server.
# BETTER_AUTH_URL=https://freundebuch.example.com

# WebAuthn / Passkey (RP = Relying Party)
# Bare domain, no scheme and no port (e.g., freundebuch.example.com). Only
# `localhost` works for local development; docker-compose.prod.yml requires a
# real value because the fallback silently breaks passkey registration.
WEBAUTHN_RP_ID=localhost

# Email (SMTP). Without SMTP_HOST no mail is sent at all: "forgot password"
# still answers 200 but the reset link only reaches the log (dev) or nowhere
# (production).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Envelope sender; defaults to no-reply@<FRONTEND_URL host>
SMTP_FROM=
# true for implicit TLS (port 465), false for STARTTLS (587/25)
SMTP_SECURE=false

# Set to true on a private instance to reject new registrations (403) and hide
# the register link in the frontend.
DISABLE_SIGNUP=false

# Optional
LOG_LEVEL=debug

# Nginx Logging (production only)
# NGINX_ACCESS_LOG: "off" (default) to disable, "/dev/stdout" to enable access logs
NGINX_ACCESS_LOG=off
# NGINX_ERROR_LOG_LEVEL: debug, info, notice, warn (default), error, crit, alert, emerg
NGINX_ERROR_LOG_LEVEL=warn

# Sentry (optional, for error tracking)
# Get your DSN from https://sentry.io
SENTRY_DSN=
# For source map uploads during frontend build
SENTRY_AUTH_TOKEN=
# Frontend-specific Sentry DSN (optional, can use same as backend)
VITE_SENTRY_DSN=
