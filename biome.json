{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": ["@datenknoten/biome-config/biome"],
  "files": {
    "includes": [
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/.svelte-kit",
      "!**/coverage",
      "!**/*.types.ts",
      "!**/*.queries.ts",
      "!**/vendor",
      "!**/editor/inline-preview"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "globals": ["__APP_VERSION__"]
  },
  "overrides": [
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "style": {
            "useConst": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
            "noUndeclaredVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["database/migrations/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["dangerfile.ts", "packages/danger/**"],
      "javascript": {
        "globals": ["danger", "fail", "warn", "message", "markdown"]
      },
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    }
  ]
}
