{
  "name": "freundebuch2",
  "version": "3.3.4",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Freundebuch - A digital friendship book for adults",
  "scripts": {
    "dev": "aube --parallel --stream run dev",
    "build": "aube --filter @freundebuch/shared run build && aube --filter '!@freundebuch/shared' --recursive run build",
    "test": "aube --filter @freundebuch/shared run build && aube --recursive run test && aube run test:php",
    "test:php": "cd apps/sabredav && ./vendor/bin/phpunit",
    "test:php:unit": "cd apps/sabredav && ./vendor/bin/phpunit --testsuite Unit",
    "test:unit": "aube --recursive run test:unit",
    "test:integration": "aube --recursive run test:integration",
    "test:e2e": "aube --recursive run test:e2e",
    "test:watch": "aube --parallel --recursive run test:watch",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "type-check": "aube --filter @freundebuch/shared run build && aube --recursive run type-check",
    "migrate": "aube --filter @freundebuch/backend run migrate",
    "migrate:build": "tsc --project database/tsconfig.json",
    "migrate:prod": "node node_modules/node-pg-migrate/bin/node-pg-migrate.js --decamelize --migrations-dir database/dist up",
    "migrate:create": "aube --filter @freundebuch/backend run migrate:create",
    "pgtyped": "aube --filter @freundebuch/backend run pgtyped",
    "pgtyped:watch": "aube --filter @freundebuch/backend run pgtyped:watch",
    "seed": "aube --filter @freundebuch/backend run seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "prepare": "(git config --get core.hooksPath 2>/dev/null | grep -q husky && git config --unset-all core.hooksPath) || true; command -v hk >/dev/null && hk install --mise; ! command -v aube >/dev/null || aube --filter @freundebuch/frontend run sync --no-install || true",
    "release": "semantic-release",
    "version:sync": "node scripts/sync-versions.mjs",
    "generate:assets": "node scripts/generate-logo-assets.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "node-pg-migrate": "8.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@datenknoten/biome-config": "1.1.0",
    "@datenknoten/commitlint-config": "1.1.0",
    "@datenknoten/kit": "1.1.0",
    "@datenknoten/tsconfig": "1.1.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/exec": "7.0.3",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/gitlab": "13.3.3",
    "@types/node": "25.0.3",
    "@types/pg": "8.16.0",
    "arktype": "2.2.8",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "danger": "12.3.3",
    "pg": "8.16.3",
    "pino": "10.4.0",
    "semantic-release": "24.2.5",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "yargs": "18.2.0"
  }
}
