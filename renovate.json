{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Berlin",
  "rangeStrategy": "pin",
  "automerge": false,
  "labels": ["dependencies"],
  "prConcurrentLimit": 3,
  "commitMessageLowerCase": "never",
  "rebaseWhen": "conflicted",
  "postUpgradeTasks": {
    "commands": [
      "git checkout {{{baseBranch}}} -- pnpm-lock.yaml",
      "npx --yes @endevco/aube@1.2.0 install --lockfile-only --fix-lockfile"
    ],
    "fileFilters": ["pnpm-lock.yaml"],
    "executionMode": "branch"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"],
    "postUpgradeTasks": {
      "commands": ["rm -f pnpm-lock.yaml", "npx --yes @endevco/aube@1.2.0 install --lockfile-only"],
      "fileFilters": ["pnpm-lock.yaml"],
      "executionMode": "branch"
    }
  },
  "pin": {
    "description": "Pin updates default to rebaseWhen=behind-base-branch, which repushes the branch on every commit to main and costs a pipeline each time",
    "rebaseWhen": "conflicted"
  },
  "major": {
    "dependencyDashboardApproval": true
  },
  "packageRules": [
    {
      "description": "One MR for everything without a major bump: an MR pipeline here runs the whole test suite plus docker-smoke, so a fan-out of MRs is paid per service",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The aube that regenerates pnpm-lock.yaml in postUpgradeTasks must stay on the version that mise.toml pins",
      "managerFilePatterns": ["/^renovate\\.json$/"],
      "matchStrings": ["@endevco/aube@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "@endevco/aube",
      "datasourceTemplate": "npm"
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "groupName": "security fixes",
    "groupSlug": "security",
    "dependencyDashboardApproval": false
  }
}
